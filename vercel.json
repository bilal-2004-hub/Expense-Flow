{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/login",
      "destination": "/client/login.html"
    },
    {
      "source": "/signup",
      "destination": "/client/signup.html"
    },
    {
      "source": "/dashboard",
      "destination": "/client/dashboard.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/client/forgot-password.html"
    },
    {
      "source": "/transactions",
      "destination": "/client/transactions.html"
    },
    {
      "source": "/analytics",
      "destination": "/client/analytics.html"
    },
    {
      "source": "/settings",
      "destination": "/client/settings.html"
    },
    {
      "source": "/",
      "destination": "/client/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/client/$1"
    }
  ]
}
